{
  "name": "selleck-homestead",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run placeholders && vite",
    "build": "npm run placeholders && npm run content:check && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "tsx scripts/sim.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "manifest": "node scripts/manifest.mjs",
    "art:process": "node scripts/art-process.mjs",
    "content:check": "tsx scripts/content-check.ts",
    "typecheck": "tsc --noEmit",
    "format:content": "node scripts/fmt-json.mjs content/*.json content/personal/*.json",
    "art:needed": "node scripts/art-needed.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2",
    "workbox-window": "^7.4.1"
  },
  "description": "Selleck Homestead: a cozy idle farm game (PWA).",
  "engines": {
    "node": ">=20"
  }
}
